class Program
{
    static void Main()
    {
        const int CENA = 35;
        int[] mince = { 1, 2, 5, 10, 20, 50 };
        int soucet = 0;

        while ( soucet < CENA)
        {
            Console.Write("Zadej minci: ");
            int vstup = int.Parse(Console.ReadLine());

            if(!mince.Contains(vstup))
            {
                Console.WriteLine("Neplatná mince\n");
                continue;
            }
            soucet += vstup;
            Console.WriteLine($"Součet: {soucet}\n");
        }

        Console.WriteLine("Zde máš nápoj");
        Console.WriteLine($"Získáváš zpět: {soucet-CENA}");
    }
}
